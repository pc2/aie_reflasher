// AIEPdiLoader: Tapasco PE that exercises the PDI-Loader platform feature from the host.
//
// The actual loading is done by Tapasco's PDILoader core (toolflow/vivado/common/ip/PDILoader, the
// `PDI-Loader` feature instantiates one per PE interface and wires it to the CIPS S_AXI_LPD port).
// This PE only forwards a Tapasco job to the loader over its PDILoad master interface
// (M_PDI_LOAD: a start handshake with the PDI's PS address, a finish handshake with the verdict)
// and turns the finish into the job's return value. The IPI channel and the timeout are
// properties of the feature, not of the PE.
//
// Registers (tapasco_ctrl_slave): 0x00 CTRL, 0x10 return value,
//   0x20 PDI_ADDRESS  PS physical address of the partial PDI (0x100_0000_0000 + Tapasco device offset)
// Return value: [0..32] PLMI status (0 = success) or 0xFFFFFF00|error for loader errors
//   (1 write response, 2 read response, 3 timeout, 4 PLM status != 0, 5 channel busy),
//   [32..64] XilLoader status when the PLM reported an error (4), otherwise the cycles from the
//   accepted start to the finish, counted here.

module AIEPdiLoader {
    clock aclk
    input bool aresetn

    gen int CTRL_AXI_WIDTH = 64
    gen int CTRL_ADDR_WIDTH = 12

    // input_regs[0] = PDI_ADDRESS
    tapasco_ctrl_slave#(NUM_INPUT_REGS: 1, ADDR_WIDTH: CTRL_ADDR_WIDTH, AXI_WIDTH: CTRL_AXI_WIDTH) ctrl

    domain axi_control
    input  int#(0..1 << CTRL_ADDR_WIDTH)    s_axi_control_awaddr
    input  bool                     s_axi_control_awvalid
    output bool                     s_axi_control_awready = ctrl.awready
    input  bool[CTRL_AXI_WIDTH]     s_axi_control_wdata
    input  bool[CTRL_AXI_WIDTH / 8] s_axi_control_wstrb
    input  bool                     s_axi_control_wvalid
    output bool                     s_axi_control_wready  = ctrl.wready
    output bool[2]                  s_axi_control_bresp   = ctrl.bresp
    output bool                     s_axi_control_bvalid  = ctrl.bvalid
    input  bool                     s_axi_control_bready
    input  int#(0..1 << CTRL_ADDR_WIDTH)    s_axi_control_araddr
    input  bool                     s_axi_control_arvalid
    output bool                     s_axi_control_arready = ctrl.arready
    output bool[CTRL_AXI_WIDTH]     s_axi_control_rdata   = ctrl.rdata
    output bool[2]                  s_axi_control_rresp   = ctrl.rresp
    output bool                     s_axi_control_rvalid  = ctrl.rvalid
    input  bool                     s_axi_control_rready
    ctrl.awaddr  = s_axi_control_awaddr
    ctrl.awvalid = s_axi_control_awvalid
    ctrl.wdata   = s_axi_control_wdata
    ctrl.wstrb   = s_axi_control_wstrb
    ctrl.wvalid  = s_axi_control_wvalid
    ctrl.bready  = s_axi_control_bready
    ctrl.araddr  = s_axi_control_araddr
    ctrl.arvalid = s_axi_control_arvalid
    ctrl.rready  = s_axi_control_rready

    domain tapasco_intr
    output bool intr = ctrl.intr

    // ---------------------------------------------------------------- PDILoad master
    // Port names = the logical names of pc2.uni-paderborn.de:lennart:PDILoad_rtl:1.0 in lower case,
    // so the IP packager infers the interface (tapasco/pack_pdi_loader_kernel.tcl checks that).
    domain pdi_load
    output bool     M_PDI_LOAD_start_valid'0
    input  bool     M_PDI_LOAD_start_ready'0
    output bool[64] M_PDI_LOAD_start_addr'0  = ctrl.input_regs[0]
    input  bool     M_PDI_LOAD_finish_valid'0
    output bool     M_PDI_LOAD_finish_ready'0 = true   // a finish is always taken at once
    input  bool[8]  M_PDI_LOAD_finish_error'0
    input  bool[32] M_PDI_LOAD_finish_status'0
    input  bool[32] M_PDI_LOAD_finish_loader_status'0

    // A launch holds the start until the loader takes it (it is busy with the previous job otherwise)
    state bool start_pending
    when ctrl.start {
        start_pending = true
    }
    M_PDI_LOAD_start_valid = start_pending
    state int#(0..1 << 32) cycles
    when start_pending & M_PDI_LOAD_start_ready {
        start_pending = false
        cycles = 0
    }
    when !start_pending {
        cycles = (cycles + 1) mod (1 << 32)
    }

    when M_PDI_LOAD_finish_valid {
        int#(0..256) error_code = BitsToUInt(M_PDI_LOAD_finish_error)
        bool[64] result
        when error_code == 0 | error_code == 4 {
            result[0..32] = M_PDI_LOAD_finish_status
        } else {
            bool[32] local_err = 32'hFFFFFF00
            local_err[0..8] = M_PDI_LOAD_finish_error
            result[0..32] = local_err
        }
        when error_code == 4 {
            result[32..64] = M_PDI_LOAD_finish_loader_status
        } else {
            result[32..64] = UIntToBits(cycles)
        }
        ctrl.finish(result)
    }

    when !aresetn {
        ctrl.rst()
        start_pending = false
    }
}
